            1                as Trans_Ty,
            1                as Grp_Cd,
            t.MANTAS_POST_DT as Trans_Dt,
            t.BENEF_ACCT_ID as ACCT_INTRL_ID,
            case when t.TRSTD_TRXN_FL = 'Y' then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end as Trusted_Trxn_Amt,
            t.FUNC_CRNCY_CD
       FROM
            fccmatomic.MI_TRXN t,
            fccmatomic.ACCT a,
            Incld_Cust c
    WHERE
          t.BENEF_ACCT_ID = a.ACCT_INTRL_ID
      AND a.prmry_cust_intrl_id is not null
      AND ('Y' = 'Y' or t.SRC_SYS_CD in ('Inactive'))
