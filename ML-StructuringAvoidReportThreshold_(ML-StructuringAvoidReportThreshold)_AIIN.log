           AND a.LAST_ACTVY_DT <= (SELECT max(b.CLNDR_DT) FROM &&mantas_schema_owner..KDD_CAL b WHERE b.CLNDR_NM = 'SYSCAL' AND b.CLNDR_DAY_AGE=0 ) )
          )*/
      AND c.CUST_INTRL_ID = a.PRMRY_CUST_INTRL_ID
