      AND t.DATA_DUMP_DT > (select Min_Dt from clndr_vw) and t.DATA_DUMP_DT <= (select Max_Dt from clndr_vw) 
            -- PR32809
            -- Cover only GENERAL transactions
      AND t.MANTAS_TRXN_PURP_CD = 'GENERAL'
      AND t.MANTAS_TRXN_PRDCT_CD in ('CASH-EQ-CASHIER-CHECK', 'CASH-EQ-CERT-CHECK', 'CASH-EQ-MONEY-ORDER', 'CASH-EQ-TRAVELERS-CHECK', 'CASH-EQ-OTHER', 'CASH-LETTER', 'CHECK', 'PAPER-OTHER', 'CHECK-ACH')
      AND ('Y' = 'Y' or COALESCE(t.TRSTD_TRXN_FL,'N') ='N')
      -- allow user to include (Y) or exclude (N)  Bank-to-Bank transactions between related parties
      AND ('Y' = 'Y' or NOT(t.BANK_TO_BANK_TRNFR_FL = 'Y' and t.PASS_THRU_FL = 'N'))
      -- Divide By Zero error handling
      AND DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) IS NOT NULL AND DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) <> 0
      AND 'Y' = 'Y'
      --30232271
      --Exclude Canceled and Canceling Transactions
      AND t.CXL_PAIR_TRXN_INTRL_ID IS NULL
      
UNION ALL

SELECT c.CUST_INTRL_ID,
            (case when DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) - trunc(DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM),-4) = 0 then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  when t.ISSUE_TRXN_ACTVY_AM - trunc(t.ISSUE_TRXN_ACTVY_AM,-4) = 0 then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  when t.CLR_TRXN_ACTVY_AM - trunc(t.CLR_TRXN_ACTVY_AM,-4) = 0 then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  when t.DEP_TRXN_ACTVY_AM - trunc(t.DEP_TRXN_ACTVY_AM,-4) = 0 then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  else 0 end) Lrf_Amt,
            (case when t.BENEF_NTITY_RISK_NB > 0 or t.BENEF_ACTVY_RISK_NB > 0 then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end) as Hr_Amt,
            (case when t.PASS_THRU_FL = 'Y' then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end) Pass_Thru_Amt,
            --25048632
            (SELECT k.BUS_DAY_AGE FROM fccmatomic.KDD_CAL k WHERE k.CLNDR_NM = 'SYSCAL' AND k.CLNDR_DT = t.MANTAS_POST_DT) as BUS_DAY_AGE,
            (SELECT k.CLNDR_DAY_AGE FROM fccmatomic.KDD_CAL k WHERE k.CLNDR_NM = 'SYSCAL' AND k.CLNDR_DT = t.MANTAS_POST_DT) as CLNDR_DAY_AGE,
            t.FO_TRXN_SEQ_ID,
            DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) as Trxn_Am,
            DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)   as Dep_Trans_Amt,
            1                as Dep_Trans_Ct,
            0                as WD_Trans_Amt,
            0                as WD_Trans_Ct,
            1                as Trans_Ty,
            1                as Grp_Cd,
            t.MANTAS_POST_DT as Trans_Dt,
            t.BENEF_ACCT_ID as ACCT_INTRL_ID,
            case when t.TRSTD_TRXN_FL = 'Y' then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end as Trusted_Trxn_Amt,
