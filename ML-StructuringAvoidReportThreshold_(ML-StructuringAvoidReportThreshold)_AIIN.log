            0                as WD_Trans_Ct,
            1                as Trans_Ty,
            1                as Grp_Cd,
            t.MANTAS_POST_DT as Trans_Dt,
            t.BENEF_ACCT_ID as ACCT_INTRL_ID,
            case when t.TRSTD_TRXN_FL = 'Y' then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end as Trusted_Trxn_Amt,
            t.FUNC_CRNCY_CD
       FROM
            fccmatomic.MI_TRXN t,
            fccmatomic.ACCT a,
            fccmatomic.CUST_ACCT ca,
            Incld_Cust c,
            fccmatomic.CUST_ACCT_ROLE car
WHERE
          t.BENEF_ACCT_ID = a.ACCT_INTRL_ID
      AND a.ACCT_INTRL_ID = ca.ACCT_INTRL_ID
      AND ca.CUST_INTRL_ID = c.CUST_INTRL_ID
