                                and cta.cust_acct_role_cd = car2.cust_acct_role_cd
                                and (car2.trdng_auth_fl = 'Y' or car2.wdrwl_auth_fl = 'Y' or car2.poa_fl = 'Y')
                                and act.ACCT_INTRL_ID = t.BENEF_ACCT_ID))
    -- ---------------------------------------------------------------------------------------------------
      AND a.MANTAS_ACCT_HOLDR_TYPE_CD in (@Incld_Acct_Hldr_Typ_Cd)
      AND a.MANTAS_ACCT_BUS_TYPE_CD in (@Mantas_Bus_Acct_Type_Lst)
    -- ---------------------------------------------------------------------------------------------------
      AND t.MANTAS_POST_DT > (select Min_Dt from clndr_vw) and t.MANTAS_POST_DT <= (select Max_Dt from clndr_vw) 
      AND t.DATA_DUMP_DT > (select Min_Dt from clndr_vw) and t.DATA_DUMP_DT <= (select Max_Dt from clndr_vw) 
      -- Cover only GENERAL transactions
      AND t.MANTAS_TRXN_PURP_CD = 'GENERAL'
