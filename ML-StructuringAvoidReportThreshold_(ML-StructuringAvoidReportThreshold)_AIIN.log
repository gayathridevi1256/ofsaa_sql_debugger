            )*/
        AND c.CUST_INTRL_ID = a.PRMRY_CUST_INTRL_ID
        AND a.MANTAS_ACCT_HOLDR_TYPE_CD in (@Incld_Acct_Hldr_Typ_Cd)
        AND a.MANTAS_ACCT_BUS_TYPE_CD in (@Mantas_Bus_Acct_Type_Lst)
    -- -----------------------------------------------------------------------------------------------------
       --25048632
        AND t.TRXN_EXCTN_DT > (select Min_Dt from clndr_vw) and t.TRXN_EXCTN_DT <= (select Max_Dt from clndr_vw) 
        AND t.DATA_DUMP_DT > (select Min_Dt from clndr_vw) and t.DATA_DUMP_DT <= (select Max_Dt from clndr_vw)        
