      /*      AND (a.LAST_ACTVY_DT is null or
          (a.LAST_ACTVY_DT > (SELECT add_days(min(b.CLNDR_DT),-Frequency_Period) FROM &&mantas_schema_owner..KDD_CAL b WHERE b.CLNDR_NM = 'SYSCAL' AND b.CLNDR_DAY_AGE=0)
           AND a.LAST_ACTVY_DT <= (SELECT max(b.CLNDR_DT) FROM &&mantas_schema_owner..KDD_CAL b WHERE b.CLNDR_NM = 'SYSCAL' AND b.CLNDR_DAY_AGE=0 ) )
          )*/
      AND c.CUST_INTRL_ID = a.PRMRY_CUST_INTRL_ID
      AND a.MANTAS_ACCT_HOLDR_TYPE_CD in ('CR')
      AND a.MANTAS_ACCT_BUS_TYPE_CD in ('RBK','RBR')
        -- ---------------------------------------------------------------------------------------------------
      --25048632
      AND t.MANTAS_POST_DT > (select Min_Dt from clndr_vw) and t.MANTAS_POST_DT <= (select Max_Dt from clndr_vw) 
