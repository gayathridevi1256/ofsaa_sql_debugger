      AND @Prmry_Cust_Fl = 'N'
      --30232271
      --Exclude Canceled and Canceling Transactions
      AND t.CXL_PAIR_TRXN_INTRL_ID IS NULL
      
UNION ALL

SELECT c.CUST_INTRL_ID,
            (case when DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) - trunc(DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM),-@Lrf_Digits) = 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  when t.ISSUE_TRXN_ACTVY_AM - trunc(t.ISSUE_TRXN_ACTVY_AM,-@Lrf_Digits) = 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  when t.CLR_TRXN_ACTVY_AM - trunc(t.CLR_TRXN_ACTVY_AM,-@Lrf_Digits) = 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  when t.DEP_TRXN_ACTVY_AM - trunc(t.DEP_TRXN_ACTVY_AM,-@Lrf_Digits) = 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                  else 0 end) Lrf_Amt,
            (case when t.SCND_BENEF_NTITY_RISK_NB > 0 or t.SCND_BENEF_ACTVY_RISK_NB > 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end) as Hr_Amt,
            (case when t.PASS_THRU_FL = 'Y' then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end) Pass_Thru_Amt,
            (SELECT k.BUS_DAY_AGE FROM fccmatomic.KDD_CAL k WHERE k.CLNDR_NM = 'SYSCAL' AND k.CLNDR_DT = t.MANTAS_POST_DT) as BUS_DAY_AGE,
