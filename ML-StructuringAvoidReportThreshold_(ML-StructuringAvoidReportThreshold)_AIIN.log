        AND @Prmry_Cust_Fl = 'Y'
        --30232271
        --Exclude Canceled and Canceling Transactions
        AND t.CXL_PAIR_TRXN_INTRL_ID IS NULL

UNION ALL

SELECT  c.CUST_INTRL_ID,
            (case when DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) - trunc(DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM),-@Lrf_Digits) = 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)
                   when t.TRXN_ACTVY_AM - trunc(t.TRXN_ACTVY_AM,-@Lrf_Digits) = 0 then DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end) as Lrf_Amt,
