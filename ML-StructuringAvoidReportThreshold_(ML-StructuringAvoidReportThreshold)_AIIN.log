            DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)   as Dep_Trans_Amt,
            1                as Dep_Trans_Ct,
            0                as WD_Trans_Amt,
            0                as WD_Trans_Ct,
            1                as Trans_Ty,
