        AND 'Y' = 'N'
                --30232271
                --Exclude Canceled and Canceling Transactions
                AND t.CXL_PAIR_TRXN_INTRL_ID IS NULL
    ) csh
  --------------------------------------------
   )  t
  group by
  t.cust_intrl_id
, t.bus_day_age
)

select
     1 as Dataset_key,
     g.CUST_INTRL_ID
   , g.Trans_Dt
   , g.Bus_Day_Age
   , g.Clndr_Day_Age
   , 0 Grp_Cd
   , -1 as Trans_Ty
   , g.One_Day_Amt
   , g.One_Day_Amt + COALESCE(t.One_Day_Amt,0) as Two_Days_Amt
   , case when g.One_Day_Amt = (g.One_Day_Amt + COALESCE(t.One_Day_Amt,0)) then 0 else 1 end as Two_Consecutive_Fl
   -- it tells us if the first day fall into range
   , case when g.One_Day_Amt >= 2500 and g.One_Day_Amt <= 2999 then 1
          when g.One_Day_Amt >= 8999 and g.One_Day_Amt <= 9999 then 1
          else 0
      end as One_Day_Amt_Fl
   -- it tells us if sum of two consecutive days fall into range and we have two consecutive days
   , case when ((g.One_Day_Amt + COALESCE(t.One_Day_Amt,0))>= 2500 and (g.One_Day_Amt + COALESCE(t.One_Day_Amt,0))<= 2999 and g.One_Day_Amt <> (g.One_Day_Amt + COALESCE(t.One_Day_Amt,0))) then 1
          when ((g.One_Day_Amt + COALESCE(t.One_Day_Amt,0))>= 8999 and (g.One_Day_Amt + COALESCE(t.One_Day_Amt,0))<= 9999 and g.One_Day_Amt <> (g.One_Day_Amt + COALESCE(t.One_Day_Amt,0))) then 1
          else 0
      end as Two_Days_Amt_Fl
  , g.Func_Crncy_Cd
  , count(1) over (partition by g.CUST_INTRL_ID) as Rec_Ct
from
      All_Trxn_B g
      left outer join All_Trxn_B t on g.CUST_INTRL_ID = t.CUST_INTRL_ID
                                   and g.bus_day_age = t.bus_day_age - 1
 ) ot ORDER BY ot.CUST_INTRL_ID, ot.BUS_DAY_AGE, ot.GRP_CD, ot.TRANS_TY
