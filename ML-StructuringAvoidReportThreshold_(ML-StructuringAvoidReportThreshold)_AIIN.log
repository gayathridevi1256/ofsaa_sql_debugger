            (SELECT k.CLNDR_DAY_AGE FROM fccmatomic.KDD_CAL k WHERE k.CLNDR_NM = 'SYSCAL' AND k.CLNDR_DT = t.TRXN_EXCTN_DT) as CLNDR_DAY_AGE,
            t.FO_TRXN_SEQ_ID,
            DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) as Trxn_Am,
            DECODE(@Curr_Type,'F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM)  as Dep_Trans_Amt,
            1               as Dep_Trans_Ct,
            0               as WD_Trans_Amt,
            0               as WD_Trans_Ct,
            0               as Trans_Ty,
            1               as Grp_Cd,
            t.trxn_exctn_dt as Trans_Dt,
            t.ACCT_INTRL_ID,
            t.FUNC_CRNCY_CD

       FROM
            fccmatomic.CASH_TRXN t,
            fccmatomic.ACCT a,
            fccmatomic.CUST_ACCT ca,
            Incld_Cust c,
