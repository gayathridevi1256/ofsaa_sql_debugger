            0               as WD_Trans_Amt,
            0               as WD_Trans_Ct,
            0               as Trans_Ty,
            1               as Grp_Cd,
            t.trxn_exctn_dt as Trans_Dt,
            t.ACCT_INTRL_ID,
            t.FUNC_CRNCY_CD

       FROM
            fccmatomic.CASH_TRXN t,
            fccmatomic.ACCT a,
            fccmatomic.CUST_ACCT ca,
            Incld_Cust c,
            fccmatomic.CUST_ACCT_ROLE car
WHERE
            t.ACCT_INTRL_ID = a.ACCT_INTRL_ID
        AND a.ACCT_INTRL_ID = ca.ACCT_INTRL_ID
        AND ca.CUST_INTRL_ID = c.CUST_INTRL_ID
        AND ca.CUST_ACCT_ROLE_CD = car.CUST_ACCT_ROLE_CD
        AND (car.TRDNG_AUTH_FL = 'Y' or car.WDRWL_AUTH_FL = 'Y' or car.POA_FL = 'Y')
