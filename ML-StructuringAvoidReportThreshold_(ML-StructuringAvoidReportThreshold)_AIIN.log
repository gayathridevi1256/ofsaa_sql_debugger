            (case when t.CASH_TRXN_NTITY_RISK_NB > 0 or t.CASH_TRXN_ACTVY_RISK_NB > 0 then DECODE('B','F',t.TRXN_FUNC_AM,t.TRXN_BASE_AM) else 0 end) as Hr_Amt,
