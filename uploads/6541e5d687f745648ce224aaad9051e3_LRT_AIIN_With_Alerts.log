and 'Y' = 'N'
-- Account Customer Role will be viewed as disretionary  
and (car.trdng_auth_fl = 'Y' or car.wdrwl_auth_fl = 'Y' or car.poa_fl = 'Y')
--PR-47385
and tr.CXL_PAIR_TRXN_INTRL_ID is null
 ) ot, TT_DLY_116000099_4_1 RMT WHERE ot.CUST_ID = RMT.FOCAL_ENTITY_ID ORDER BY ot.FO_TRXN_SEQ_ID
