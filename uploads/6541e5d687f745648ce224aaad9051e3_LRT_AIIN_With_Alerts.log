AND @Primary_Cust_Fl = 'N'
)


SELECT  distinct
          s.CUST_ID as CUST_INTRL_ID,
          s.ACCT_SEQ_ID,
          s.ACCT_INTRL_ID

FROM (
-- WIRE Credit BENE 
SELECT    ca.CUST_ID,
          ca.ACCT_SEQ_ID,
          ca.ACCT_INTRL_ID
FROM      Wire_Trxn_Vw tr,
          Cust_Accounts ca
WHERE     
--21153210, 31536090 
