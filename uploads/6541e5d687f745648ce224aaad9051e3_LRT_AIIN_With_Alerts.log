--27476375 
Cust_Accounts as
(SELECT 
        c.CUST_SEQ_ID,
        ac.PRMRY_CUST_INTRL_ID CUST_ID,
        ac.ACCT_INTRL_ID,
        ac.ACCT_SEQ_ID, 
        c.CUST_EFCTV_RISK_NB
FROM        
 fccmatomic.ACCT ac,
