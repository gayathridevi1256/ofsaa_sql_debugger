-- agrawalr on 15th july '2010: Added Trusted pair functionality as per PR 44565
-- agrawalr on 15th Mar, 2010: PR 42468: Adding Cust table and 3 filters
-- 09/15/2009   PR 39625   
-- In the SELECT clause (where  @Primary_Cust_Fl = 'N')
-- Added CUST table
-- Replaced ACCT.PRMRY_CUST_INTRL_ID 
-- BY: CUST.CUST_INTRL_ID
-- Added filters : 
-- "CUST.CUST_EFCTV_RISK_NB <> -2"  
-- and "(@All_Jurisdictions_Fl = 'Y' or CUST.JRSDCN_CD in (@Incl_Jurisdictions_Lst))"
-- 06/02/2005  CR 24685   Joint Account and Beneficial Owners
-- 06/02/2005  CR 24683   Excluding Activities Between Related Parties
-- Only one part of UNION ALL will be executed 
-- threshold @Primary_Cust_Fl define which of them  
-- @Primary_Cust_Fl is parameter that indicates what account are included for customer focus to monitor :
-- Y - cover only accounts for which a customer plays a primary role
-- N - cover account over which a customer has a discretion
SELECT 
           tr.FO_TRXN_SEQ_ID,
           ac.PRMRY_CUST_INTRL_ID CUST_ID
FROM    fccmatomic.MI_TRXN tr,
		    fccmatomic.ACCT ac,
		    fccmatomic.CUST c   -- PR 42468: Adding Cust Table
WHERE    
--21153210
( 
(tr.BENEF_ACCT_ID = ac.ACCT_INTRL_ID AND tr.INTRL_BENEF_ACCT_FL = 'Y')
OR
(tr.SCND_BENEF_ACCT_ID = ac.ACCT_INTRL_ID AND tr.INTRL_SCND_BENEF_ACCT_FL = 'Y'
 AND       
 (tr.INTRL_BENEF_ACCT_FL <> 'Y' 
 OR  
 ac.PRMRY_CUST_INTRL_ID <> COALESCE((select a.PRMRY_CUST_INTRL_ID from fccmatomic.ACCT a where a.ACCT_INTRL_ID = tr.BENEF_ACCT_ID),'-')
 )
)
) 
-- PR 42468 Starts: Adding filters:
AND       c.cust_intrl_id = ac.prmry_cust_intrl_id
AND       c.CUST_EFCTV_RISK_NB <> -2 
AND       (@All_Jurisdictions_Fl = 'Y' or c.JRSDCN_CD in (@Incl_Jurisdictions_Lst))
-- PR 42468 Ends
-- Cover either all transaction or only form the Incl_Trans_Src_Lst 
AND       (@All_Trans_Src_Fl='Y' OR tr.SRC_SYS_CD IN (@Incl_Trans_Src_Lst))
-- Cover only specific accounts 
AND       ac.MANTAS_ACCT_BUS_TYPE_CD in (@Mantas_Bus_Acct_Type_Lst)
--	Include Retail Customer Accounts Only   
and       ac.MANTAS_ACCT_HOLDR_TYPE_CD in (@Incld_Acct_Hldr_Typ_Cd)
--AND       ac.PRMRY_CUST_INTRL_ID is not null  --commented as per PR39625
and       DECODE(@Curr_Type,'F',tr.TRXN_FUNC_AM,tr.TRXN_BASE_AM) >=@Min_Individual_Trans_Amt
and       tr.MANTAS_TRXN_PURP_CD = 'GENERAL'
and       tr.MANTAS_TRXN_PRDCT_CD in (@Incl_MI_Trxn_Prdct_Type_Lst)
-- ------------------------------------------------------------------------------------------------------
--21153210
and tr.MANTAS_POST_DT IN (SELECT KC.CLNDR_DT FROM fccmatomic.KDD_CAL KC WHERE KC.CLNDR_NM='SYSCAL' AND KC.CLNDR_DAY_AGE between 0 and @Look_Back_Period - 1)
and tr.DATA_DUMP_DT IN (SELECT KC.CLNDR_DT FROM fccmatomic.KDD_CAL KC WHERE KC.CLNDR_NM='SYSCAL' AND KC.CLNDR_DAY_AGE between 0 and @Look_Back_Period - 1)
--Parameter that indicates what account are included for customer focus to monitor :
--Y - cover only accounts for which a customer plays a primary role
--N - cover account over which a customer has a discretion
and @Primary_Cust_Fl = 'Y'
-- allow user to include or exclude related parties
and (@Include_Related_Parties_Fl = 'Y' or   (tr.UNRLTD_PARTY_FL = 'Y' or tr.UNRLTD_PARTY_FL IS NULL))
-- allow user to include (Y) or exclude (N)  Bank-to-Bank transactions between related parties
and (@Include_B2B_Trnfr_Fl = 'Y' or NOT(tr.BANK_TO_BANK_TRNFR_FL = 'Y' and tr.PASS_THRU_FL = 'N'))
and (@Include_Trusted_Trans_FL = 'Y' or COALESCE(tr.TRSTD_TRXN_FL,'N') ='N')
