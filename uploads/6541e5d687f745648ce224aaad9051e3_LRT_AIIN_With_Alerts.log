and       tr.DATA_DUMP_DT IN (SELECT KC.CLNDR_DT FROM fccmatomic.KDD_CAL KC WHERE KC.CLNDR_NM='SYSCAL' AND KC.CLNDR_DAY_AGE between 0 and 14 - 1)
--Parameter that indicates what account are included for customer focus to monitor :
