UNION ALL

-- WIRE Credit SCND_BENE 
SELECT    ca.CUST_ID,
          ca.ACCT_SEQ_ID,
          ca.ACCT_INTRL_ID			 
FROM      Wire_Trxn_Vw tr,
          Cust_Accounts ca
